YOJ_HTTP_ADDR=:8080

YOJ_DB_HOST=127.0.0.1
YOJ_DB_PORT=3306
YOJ_DB_USER=root
YOJ_DB_PASSWORD=root
YOJ_DB_NAME=yoj
YOJ_DB_MAX_OPEN_CONNS=30
YOJ_DB_MAX_IDLE_CONNS=10
YOJ_DB_CONN_MAX_LIFETIME_SECONDS=1800
YOJ_DB_CONN_MAX_IDLE_TIME_SECONDS=300

YOJ_REDIS_ADDR=127.0.0.1:6379
YOJ_REDIS_PASSWORD=
YOJ_REDIS_DB=0

YOJ_RABBITMQ_URL=amqp://yoj:yoj-dev-password@127.0.0.1:5672/
YOJ_RABBITMQ_JUDGE_QUEUE=yoj.judge.tasks
YOJ_RABBITMQ_JUDGE_DEAD_QUEUE=yoj.judge.tasks.dead
YOJ_RABBITMQ_QUEUE_TYPE=classic
YOJ_RABBITMQ_PUBLISH_TIMEOUT_MS=5000
YOJ_RABBITMQ_PUBLISH_CHANNELS=8

YOJ_JUDGE_CAPACITY_KEY=yoj:judge:capacity
YOJ_JUDGE_MAX_INFLIGHT=200
YOJ_JUDGE_ADMISSION_TTL_SECONDS=21600
YOJ_JUDGE_RETRY_AFTER_SECONDS=3
YOJ_JUDGE_MAX_RETRIES=2

YOJ_WORKER_NAME=
YOJ_WORKER_CONCURRENCY=2
YOJ_WORKER_PREFETCH=2

YOJ_JWT_SECRET=change-me-in-real-deployments
YOJ_JWT_EXPIRE_HOURS=168

# Legacy name retained for compatibility. RabbitMQ is now the judge queue.
YOJ_JUDGE_QUEUE=yoj:judge:queue
YOJ_JUDGE_MODE=host

YOJ_GO_BIN=go
YOJ_C_COMPILER_BIN=gcc
YOJ_CPP_COMPILER_BIN=g++
YOJ_PYTHON_BIN=D:\Anaconda\envs\py310\python.exe

YOJ_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
YOJ_ADMIN_USERNAME=admin
YOJ_ADMIN_PASSWORD=admin123
